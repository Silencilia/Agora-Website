    <div class="grid gap-16 md:grid-cols-[1fr_280px]">
      <div>
        <a
          href="tel:+19177721242"
          class="mt-6 block max-w-full text-2xl font-light tracking-tight break-all transition-colors hover:text-brand md:text-lg"
        >
        <dt class="eyebrow">Email</dt>
          info@agoradev.co.site
        </a>

        <a
          href="mailto:info@agoradev.co.site"
          class="mt-6 block max-w-full text-2xl font-light tracking-tight break-all transition-colors hover:text-brand md:text-lg"
        >
        <dt class="eyebrow">Phone</dt>
          +1 917 772 1242
        </a>
      </div>

    </div>
  </section>
</Base>
