---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects", ({ data }) => !data.draft))
    .sort((a, b) => a.data.order - b.data.order);

  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  prev: CollectionEntry<"projects"> | null;
  next: CollectionEntry<"projects"> | null;
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const categoryLabel: Record<string, string> = {
  professional: "Professional",
  academic: "Academic",
  personal: "Personal",
  research: "Research",
};

const facts: [string, string | undefined][] = [
  ["Type", categoryLabel[d.category]],
  ["Status", d.status],
  ["Location", d.location],
  ["Year", d.year],
  ["Collaborators", d.collaborators],
];
const factItems = facts.filter(([, value]) => value) as [string, string][];
---

<Base title={d.title} description={d.subtitle}>
  <article>
    <header class="mx-auto px-6 pt-14 pb-10 lg:px-40 xl:px-80 md:pt-20">
      <h1 class="max-w-4xl text-3xl font-light tracking-tight text-balance md:text-5xl">
        {d.title}
      </h1>
      {
        d.credit && (
          <p class="mt-5 text-base text-ink/70 md:text-lg">
            {d.credit.text}{" "}
            <a
              href={d.credit.url}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-ink/25 underline-offset-4 transition-colors hover:text-brand hover:decoration-brand"
            >{d.credit.firm}</a>
          </p>
        )
      }
    </header>

    {
      d.layout === "images-first" ? (
        <>
          <div class="mx-auto px-6 pb-14 lg:px-40 xl:px-80 md:pb-20">
            <dl class="grid grid-cols-2 gap-x-10 gap-y-5 text-sm md:flex md:flex-wrap md:gap-x-14">
              {factItems.map(([label, value]) => (
                <div>
                  <dt class="eyebrow">{label}</dt>
                  <dd class="mt-1 text-ink/80">{value}</dd>
                </div>
              ))}
              {d.awards.length > 0 && (
                <div class="col-span-2">
                  <dt class="eyebrow">Awards</dt>
                  <dd class="mt-1">
                    <ul class="space-y-1 text-ink/80">
                      {d.awards.map((award) => (
                        <li>{award}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
            </dl>
          </div>

          <ProjectGallery slug={project.id} variant="stack" lead={d.cover} />

          <div class="mx-auto px-6 pt-14 lg:px-40 xl:px-80 md:pt-20">
            <div class="prose-agora mx-auto">
              <Content />
            </div>
          </div>
        </>
      ) : (
        <>
          <div class="mx-auto px-6 lg:px-40 xl:px-80">
            <div class="overflow-hidden bg-mist">
              <Image
                src={d.cover}
                alt={d.title}
                widths={[800, 1400, 2000]}
                sizes="(min-width: 1536px) 1472px, 95vw"
                loading="eager"
                class="w-full object-cover"
              />
            </div>
          </div>

          <div
            class="mx-auto grid gap-12 px-6 py-14 md:grid-cols-[280px_1fr] lg:px-40 xl:px-80 md:py-20"
          >
            <aside>
              <dl class="space-y-5 text-sm">
                {
                  factItems.map(([label, value]) => (
                    <div>
                      <dt class="eyebrow">{label}</dt>
                      <dd class="mt-1 text-ink/80">{value}</dd>
                    </div>
                  ))
                }
                {
                  d.awards.length > 0 && (
                    <div>
                      <dt class="eyebrow">Awards</dt>
                      <dd class="mt-1">
                        <ul class="space-y-1 text-ink/80">
                          {d.awards.map((award) => (
                            <li>{award}</li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  )
                }
              </dl>
            </aside>

            <div class="prose-agora">
              <Content />
            </div>
          </div>

          <ProjectGallery slug={project.id} notes={d.notes} />
        </>
      )
    }

    <nav
      class="mx-auto mt-14 flex items-center justify-between px-6 py-8 md:mt-20 lg:px-40 xl:px-80"
      aria-label="Project navigation"
    >
      {
        prev ? (
          <a
            href={`/projects/${prev.id}/`}
            class="group inline-flex items-center gap-3 text-[0.7rem] uppercase tracking-(--tracking-eyebrow) text-ink/70 transition-colors hover:text-brand"
          >
            <ArrowIcon class="h-3 w-3 transition-transform group-hover:-translate-x-1" />
            {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a
            href={`/projects/${next.id}/`}
            class="group inline-flex items-center gap-3 text-right text-[0.7rem] uppercase tracking-(--tracking-eyebrow) text-ink/70 transition-colors hover:text-brand"
          >
            {next.data.title}
            <ArrowIcon class="h-3 w-3 rotate-180 transition-transform group-hover:translate-x-1" />
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Base>
