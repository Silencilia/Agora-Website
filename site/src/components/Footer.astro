---
import Logo from "./Logo.astro";
import Wordmark from "./Wordmark.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="mx-auto grid max-w-screen-2xl gap-12 px-6 py-14 md:grid-cols-3 md:px-10 md:py-20"
  >
    <div>
      <a href="/" class="flex items-center gap-4" aria-label="AGORA — home">
        <Logo class="h-9 w-auto" />
        <Wordmark class="text-brand text-sm" />
      </a>
      <p class="mt-6 max-w-xs text-sm leading-relaxed text-ink/60">
        Architecture, urbanism, and research — the practice of Minquan Wang,
        AIA.
      </p>
    </div>

    <div>
      <h2 class="eyebrow">Contact</h2>
      <ul class="mt-5 space-y-2 text-sm text-ink/80">
        <li>
          <a
            href="mailto:minquanwang00@gmail.com"
            class="transition-colors hover:text-brand"
            >minquanwang00@gmail.com</a
          >
        </li>
        <li>
          <a href="tel:+19177721242" class="transition-colors hover:text-brand"
            >+1 917 772 1242</a
          >
        </li>
        <li>New York, NY</li>
      </ul>
    </div>

    <div>
      <h2 class="eyebrow">Index</h2>
      <ul class="mt-5 space-y-2 text-sm text-ink/80">
        <li>
          <a href="/projects/" class="transition-colors hover:text-brand"
            >Projects</a
          >
        </li>
        <li>
          <a href="/about/" class="transition-colors hover:text-brand">About</a>
        </li>
        <li>
          <a href="/contact/" class="transition-colors hover:text-brand"
            >Contact</a
          >
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-screen-2xl items-center justify-between px-6 py-5 text-[0.65rem] uppercase tracking-(--tracking-eyebrow) text-ink/40 md:px-10"
    >
      <span>&copy; {year} AGORA — Minquan Wang</span>
      <span>New York</span>
    </div>
  </div>
</footer>
