---
import Logo from "./Logo.astro";
import Wordmark from "./Wordmark.astro";
---

<footer class="relative z-10 border-t border-line bg-paper">
  <div
    class="mx-auto flex max-w-screen-2xl flex-col items-center gap-6 px-6 py-14 text-center md:px-10 md:py-20"
  >
    <a href="/" class="flex items-center justify-center gap-4" aria-label="AGORA home">
      <Logo class="h-9 w-auto" />
      <Wordmark class="text-brand text-sm" />
    </a>

    <div
      class="grid w-fit sm:gap-24 gap-3 text-sm text-ink/80 sm:grid-cols-3 sm:items-center"
    >
      <a
        href="mailto:info@agoradev.co.site"
        class="transition-colors hover:text-brand sm:text-left"
      >
        info@agoradev.co.site
      </a>
      <a
        href="tel:+19177721242"
        class="transition-colors hover:text-brand sm:text-center"
      >
        +1 917 772 1242
      </a>
      <span class="sm:text-right">New York, NY</span>
    </div>
  </div>
</footer>
