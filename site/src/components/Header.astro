---
const path = Astro.url.pathname;

const links = [
  { href: "/", label: "AGORA" },
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];

const isActive = (href: string) => {
  if (href === "/") return path === "/";
  return (
    path === href || path === href.replace(/\/$/, "") || path.startsWith(href)
  );
};
---

{/*
  Full-bleed masthead: the four nav words span the entire page width in
  large caps, sizing (and header height) in `vw` so they scale with the
  viewport. Fixed overlay: hides on scroll-down, reveals instantly on
  scroll-up. Solid background, no border.
*/}
<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 bg-paper transition-transform duration-300 ease-out will-change-transform"
>
  <nav
    class="flex flex-nowrap items-baseline justify-between gap-x-[1.5vw] px-[2.5vw] py-[1.6vw]"
    aria-label="Primary"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class:list={[
            "whitespace-nowrap font-light uppercase leading-none tracking-tight text-[5.15vw] transition-colors hover:text-brand",
            isActive(link.href) ? "text-brand" : "text-ink",
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  if (header) {
    // Publish the header height so pages can offset their content beneath it.
    const publishHeight = () =>
      document.documentElement.style.setProperty(
        "--header-h",
        `${header.offsetHeight}px`,
      );
    publishHeight();
    window.addEventListener("resize", publishHeight);

    let lastY = window.scrollY;
    let ticking = false;
    const THRESHOLD = 6; // ignore tiny jitters

    const update = () => {
      const y = window.scrollY;
      if (y <= header.offsetHeight) {
        // At/near the top: always visible.
        header.style.transform = "translateY(0)";
      } else if (Math.abs(y - lastY) > THRESHOLD) {
        // Hide when scrolling down, reveal immediately when scrolling up.
        header.style.transform =
          y > lastY ? "translateY(-100%)" : "translateY(0)";
      }
      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>
