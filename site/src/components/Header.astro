---
import Logo from "./Logo.astro";
import Wordmark from "./Wordmark.astro";

const path = Astro.url.pathname;

const links = [
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];

const isActive = (href: string) =>
  path === href || path === href.replace(/\/$/, "") || path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur-sm">
  <div
    class="mx-auto flex h-16 max-w-screen-2xl items-center justify-between px-6 md:h-20 md:px-10"
  >
    <a href="/" class="group flex items-center gap-4" aria-label="AGORA — home">
      <Logo class="h-8 w-auto md:h-9" />
      <Wordmark
        class="text-brand text-[0.9rem] md:text-base transition-opacity group-hover:opacity-70"
      />
    </a>

    <nav class="hidden items-center gap-9 md:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "text-[0.7rem] uppercase tracking-(--tracking-eyebrow) transition-colors hover:text-brand",
              isActive(link.href) ? "text-brand" : "text-ink/75",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <button
      id="menu-button"
      type="button"
      class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <span class="h-px w-6 bg-ink transition-transform"></span>
      <span class="h-px w-6 bg-ink transition-transform"></span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    hidden
    class="border-t border-line bg-paper md:hidden"
    aria-label="Primary mobile"
  >
    <ul class="flex flex-col px-6 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "block py-3 text-xs uppercase tracking-(--tracking-eyebrow)",
                isActive(link.href) ? "text-brand" : "text-ink/80",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const button = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-menu");

  button?.addEventListener("click", () => {
    const isOpen = menu?.toggleAttribute("hidden") === false;
    button.setAttribute("aria-expanded", String(isOpen));
  });
</script>
