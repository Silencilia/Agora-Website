---
import { Image } from "astro:assets";

interface Interlude {
  /** Insert this text after the Nth gallery image (1-indexed). */
  after: number;
  heading?: string;
  body: string;
}

interface Props {
  slug: string;
  interludes?: Interlude[];
}

const { slug, interludes = [] } = Astro.props;

// Eagerly load every project's gallery images, then keep this project's.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/projects/*/g*.{jpg,jpeg,png}",
  { eager: true },
);
const prefix = `/src/content/projects/${slug}/`;
const images = Object.entries(modules)
  .filter(([path]) => path.startsWith(prefix))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);

const ratio = (im: ImageMetadata) => im.width / im.height;

type Row = { kind: "full" | "landscape" | "portrait"; imgs: ImageMetadata[] };
type TextItem = { text: true; heading?: string; paragraphs: string[] };
type Item = Row | TextItem;

// Build rows: wide panoramas full-width, portraits paired, others single.
const rows: Row[] = [];
let i = 0;
while (i < images.length) {
  const im = images[i];
  const r = ratio(im);
  if (r >= 1.9) {
    rows.push({ kind: "full", imgs: [im] });
    i += 1;
  } else if (r <= 0.85) {
    const next = images[i + 1];
    if (next && ratio(next) <= 0.85) {
      rows.push({ kind: "portrait", imgs: [im, next] });
      i += 2;
    } else {
      rows.push({ kind: "portrait", imgs: [im] });
      i += 1;
    }
  } else {
    rows.push({ kind: "landscape", imgs: [im] });
    i += 1;
  }
}

// Interleave interludes after the row that reaches their `after` count.
const pending = [...interludes].sort((a, b) => a.after - b.after);
const toText = (it: Interlude): TextItem => ({
  text: true,
  heading: it.heading,
  paragraphs: it.body.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean),
});

const items: Item[] = [];
let consumed = 0;
for (const row of rows) {
  items.push(row);
  consumed += row.imgs.length;
  while (pending.length && pending[0].after <= consumed) {
    items.push(toText(pending.shift()!));
  }
}
for (const rest of pending) items.push(toText(rest));

const isText = (it: Item): it is TextItem => "text" in it;
---

{
  images.length > 0 && (
    <div class="mx-auto max-w-screen-2xl space-y-6 px-6 md:space-y-10 md:px-10">
      {items.map((item) =>
        isText(item) ? (
          <div class="mx-auto max-w-2xl py-6 md:py-10">
            {item.heading && <h2 class="eyebrow mb-4">{item.heading}</h2>}
            <div class="prose-agora space-y-4">
              {item.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </div>
        ) : item.kind === "portrait" && item.imgs.length === 2 ? (
          // Paired portraits share one aspect-ratio box so both fill their
          // cell (object-cover) instead of leaving blank space below the
          // shorter image. Use the pair's mean ratio to minimise cropping.
          <div class="grid gap-4 sm:grid-cols-2 md:gap-6">
            {item.imgs.map((img) => (
              <div
                class="overflow-hidden bg-mist"
                style={`aspect-ratio:${(ratio(item.imgs[0]) + ratio(item.imgs[1])) / 2}`}
              >
                <Image
                  src={img}
                  alt=""
                  widths={[500, 900, 1400]}
                  sizes="(min-width: 1536px) 728px, (min-width: 640px) 46vw, 92vw"
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
            ))}
          </div>
        ) : item.kind === "portrait" ? (
          <div class="mx-auto max-w-xl overflow-hidden bg-mist">
            <Image
              src={item.imgs[0]}
              alt=""
              widths={[500, 900, 1400]}
              sizes="(min-width: 1536px) 728px, (min-width: 640px) 46vw, 92vw"
              loading="lazy"
              class="h-auto w-full"
            />
          </div>
        ) : (
          <div class="overflow-hidden bg-mist">
            <Image
              src={item.imgs[0]}
              alt=""
              widths={[800, 1400, 2000]}
              sizes="(min-width: 1536px) 1472px, 95vw"
              loading="lazy"
              class="h-auto w-full"
            />
          </div>
        ),
      )}
    </div>
  )
}
