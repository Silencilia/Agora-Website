---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  /** Eager-load images above the fold */
  eager?: boolean;
  /** Render the image at its native aspect ratio (masonry gallery) */
  native?: boolean;
}

const { project, eager = false, native = false } = Astro.props;
const { title, cover, year, credit } = project.data;
const href = `/projects/${project.id}/`;
---

{/*
  The whole card is clickable via a stretched link on the title (its ::after
  covers the card). The firm credit link sits above it (relative z-10), so it
  can be its own link without nesting <a> inside <a>.
*/}
<div
  class="group relative transition-transform duration-500 ease-out will-change-transform hover:z-10 hover:scale-[1.03] focus-within:scale-[1.03]"
>
  <div class:list={["overflow-hidden bg-mist", !native && "aspect-[4/3]"]}>
    <Image
      src={cover}
      alt={title}
      widths={[480, 800, 1200]}
      sizes={
        native
          ? "(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
          : "(min-width: 1024px) 45vw, (min-width: 768px) 46vw, 92vw"
      }
      loading={eager ? "eager" : "lazy"}
      class:list={[
        native ? "h-auto w-full" : "h-full w-full object-cover",
      ]}
    />
  </div>
  <div class="mt-3 flex items-baseline justify-between gap-6">
    <h3
      class="text-[0.95rem] tracking-wide transition-colors group-hover:text-brand"
    >
      <a href={href} class="after:absolute after:inset-0 after:content-['']">
        {title}
      </a>
    </h3>
    {
      year && (
        <p class="shrink-0 whitespace-nowrap text-[0.95rem] text-ink/45">{year}</p>
      )
    }
  </div>
  {
    credit && (
      <p class="mt-1 text-[0.8rem] text-ink/60">
        {credit.text}{" "}
        <a
          href={credit.url}
          target="_blank"
          rel="noopener noreferrer"
          class="relative z-10 underline decoration-ink/25 underline-offset-2 transition-colors hover:text-brand hover:decoration-brand"
        >{credit.firm}</a>
      </p>
    )
  }
</div>
