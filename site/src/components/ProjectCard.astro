---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  /** Eager-load images above the fold */
  eager?: boolean;
  /** Render the image at its native aspect ratio (masonry gallery) */
  native?: boolean;
}

const { project, eager = false, native = false } = Astro.props;
const { title, cover, year, category } = project.data;

const categoryLabel: Record<string, string> = {
  professional: "Professional",
  academic: "Academic",
  personal: "Personal",
  research: "Research",
};
---

<a href={`/projects/${project.id}/`} class="group block">
  <div class:list={["overflow-hidden bg-mist", !native && "aspect-[4/3]"]}>
    <Image
      src={cover}
      alt={title}
      widths={[480, 800, 1200]}
      sizes={
        native
          ? "(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
          : "(min-width: 1024px) 45vw, (min-width: 768px) 46vw, 92vw"
      }
      loading={eager ? "eager" : "lazy"}
      class:list={[
        "transition-transform duration-700 ease-out group-hover:scale-[1.025]",
        native ? "h-auto w-full" : "h-full w-full object-cover",
      ]}
    />
  </div>
  <div class="mt-3 flex items-baseline justify-between gap-6">
    <h3
      class="text-[0.95rem] tracking-wide transition-colors group-hover:text-brand"
    >
      {title}
    </h3>
    <p
      class="eyebrow shrink-0 whitespace-nowrap"
    >
      {categoryLabel[category]}{year && ` · ${year}`}
    </p>
  </div>
</a>
