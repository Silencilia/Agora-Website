---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  /** Eager-load images above the fold */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { title, cover, year, category } = project.data;

const categoryLabel: Record<string, string> = {
  professional: "Professional",
  academic: "Academic",
  personal: "Personal",
  research: "Research",
};
---

<a href={`/projects/${project.id}/`} class="group block">
  <div class="aspect-[4/3] overflow-hidden bg-mist">
    <Image
      src={cover}
      alt={title}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 45vw, (min-width: 768px) 46vw, 92vw"
      loading={eager ? "eager" : "lazy"}
      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.025]"
    />
  </div>
  <div class="mt-3 flex items-baseline justify-between gap-6">
    <h3
      class="text-[0.95rem] tracking-wide transition-colors group-hover:text-brand"
    >
      {title}
    </h3>
    <p
      class="eyebrow shrink-0 whitespace-nowrap"
    >
      {categoryLabel[category]}{year && ` · ${year}`}
    </p>
  </div>
</a>
