---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";

const awards = [
  "Gold Winner, A' Design Award — West Zhejiang Agro-Tech Industry Park, 2025",
  "Gold Winner, APR Urban Design & Architecture Design Awards, 2025",
  "Gold Winner, NY Architectural Design Awards, 2024",
  "Bronze Prize, International Design Awards — Mixed Use, 2024",
  "Bronze Prize, International Design Awards — Cultural, 2024",
  "Silver Winner, MUSE Design Awards, 2024",
  "Gold & Silver Winner, London Design Awards, 2024",
  "Honorable Mention, Non Architecture Competitions, 2019",
  "H.I. Feldman Prize, Yale School of Architecture, 2017",
];

const exhibitions = [
  "40×40 International Exhibition — Blanc Gallery, New York, 2025",
  "ITSLIQUID Venice International Art Fair — Palazzo Albrizzi-Capello, Venice, 2025",
  "ITSLIQUID Borders Art Fair — Palazzo Albrizzi-Capello, Venice, 2025",
  "ITSLIQUID Canvas Art Fair — ELEMENTS, London, 2025",
  "A’ Design Award Exhibition — Sala Bianco del Teatro, Como, 2025",
];
---

<Base title="About">
  <section class="mx-auto px-6 py-14 lg:px-40 xl:px-80 md:py-20">

    <div class="mt-16 grid gap-12 md:mt-24 md:grid-cols-[280px_1fr]">
      <div class="flex items-center justify-center md:justify-start">
        <div class="flex flex-col items-center gap-10 md:items-start">
          <Logo class="h-40 w-auto md:h-56" />
        </div>
      </div>

      <div class="prose-agora space-y-5 !max-w-2xl text-[0.975rem] leading-relaxed">
        <p>
          Agora is an architecture studio based in New York. It aims to build the public realm and facilitate thought exchanges with the social potency of architecture.
        </p>
        <p>
          Agora was founded by Minquan Wang in 2022. Minquan is a registered architect in Connecticut and a member of the American Institute of Architecture. He serves professionally as an Associate Principal at Kohn Pedersen Fox in New York, where he was involved in several large-scale high-profile mixed-use development projects including the Chongqing International Land-Sea Center, Baker Circle, and Thamrin Nine. 
          He previously served as an Architect at David Chipperfield Architects Shanghai, where he played critical roles in the Shanghai office's design-focused projects and cultural/academic engagements, including being the leading designer in high profile competitions such as Jinqiao Art Center and Minsheng Wharf Masterplan, and the project architect for the 2023 RAM Assembles. 
        </p>
        <p>
         Minquan's independent works have received numerous accolades and awards internationally. His winning proposal of West Zhejiang Agro-Tech Campus, collaborated with SIZE Arch and ZJUT Engineering Design Group, was the Gold Winner of A' Design Award 2025, Gold Winner of APR Urban Design & Architecture Design Awards 2025, Bronze Prize winner of International Design Awards 2024, and Gold Winner of NY Architectural Design Awards. His proposal for China Academy of Art Mengyuan Campus, was the Bronze Prize winner of International Design Awards 2024, and Silver Winner of MUSE Design Awards 2024.
        </p>
        <p>
          Minquan taught the Option Studio at Tongji University in Shanghai and
          is co-author of <em>Folding Jingdezhen</em>. He received his M.Arch
          from the Yale School of Architecture, where he was awarded the H.I.
          Feldman Prize, and his B.Arch and M.Arch from Tsinghua University.
        </p>
      </div>
    </div>

    <div class="mt-20 grid gap-12 border-t border-line pt-12 md:mt-28 md:grid-cols-2">
      <div>
        <h2 class="eyebrow">Awards</h2>
        <ul class="mt-5 space-y-2 text-sm text-ink/70">
          {awards.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="eyebrow">Exhibitions</h2>
        <ul class="mt-5 space-y-2 text-sm text-ink/70">
          {exhibitions.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>
