---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects", ({ data }) => !data.draft))
    .sort((a, b) => a.data.order - b.data.order);

  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  prev: CollectionEntry<"projects"> | null;
  next: CollectionEntry<"projects"> | null;
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const categoryLabel: Record<string, string> = {
  professional: "Professional",
  academic: "Academic",
  personal: "Personal",
  research: "Research",
};

const facts: [string, string | undefined][] = [
  ["Type", categoryLabel[d.category]],
  ["Status", d.status],
  ["Location", d.location],
  ["Year", d.year],
  ["Role", d.role],
  ["Collaborators", d.collaborators],
];
---

<Base title={d.title} description={d.subtitle}>
  <article>
    <header class="mx-auto max-w-screen-2xl px-6 pt-14 pb-10 md:px-10 md:pt-20">
      <p class="eyebrow">
        {categoryLabel[d.category]}{d.year && ` — ${d.year}`}
      </p>
      <h1 class="mt-4 max-w-4xl text-3xl font-light tracking-tight text-balance md:text-5xl">
        {d.title}<span class="text-brand">.</span>
      </h1>
      {
        d.subtitle && (
          <p class="mt-3 max-w-3xl text-lg font-light text-ink/60">
            {d.subtitle}
          </p>
        )
      }
    </header>

    <div class="mx-auto max-w-screen-2xl px-6 md:px-10">
      <div class="overflow-hidden bg-mist">
        <Image
          src={d.cover}
          alt={d.title}
          widths={[800, 1400, 2000]}
          sizes="(min-width: 1536px) 1472px, 95vw"
          loading="eager"
          class="w-full object-cover"
        />
      </div>
    </div>

    <div
      class="mx-auto grid max-w-screen-2xl gap-12 px-6 py-14 md:grid-cols-[280px_1fr] md:px-10 md:py-20"
    >
      <aside>
        <dl class="space-y-5 text-sm">
          {
            facts
              .filter(([, value]) => value)
              .map(([label, value]) => (
                <div>
                  <dt class="eyebrow">{label}</dt>
                  <dd class="mt-1 text-ink/80">{value}</dd>
                </div>
              ))
          }
          {
            d.awards.length > 0 && (
              <div>
                <dt class="eyebrow">Awards</dt>
                <dd class="mt-1">
                  <ul class="space-y-1 text-ink/80">
                    {d.awards.map((award) => (
                      <li>{award}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>

      <div class="prose-agora">
        <Content />
      </div>
    </div>

    <nav
      class="mx-auto flex max-w-screen-2xl items-center justify-between border-t border-line px-6 py-8 md:px-10"
      aria-label="Project navigation"
    >
      {
        prev ? (
          <a
            href={`/projects/${prev.id}/`}
            class="group inline-flex items-center gap-3 text-[0.7rem] uppercase tracking-(--tracking-eyebrow) text-ink/70 transition-colors hover:text-brand"
          >
            <ArrowIcon class="h-3 w-3 transition-transform group-hover:-translate-x-1" />
            {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a
            href={`/projects/${next.id}/`}
            class="group inline-flex items-center gap-3 text-right text-[0.7rem] uppercase tracking-(--tracking-eyebrow) text-ink/70 transition-colors hover:text-brand"
          >
            {next.data.title}
            <ArrowIcon class="h-3 w-3 rotate-180 transition-transform group-hover:translate-x-1" />
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Base>
