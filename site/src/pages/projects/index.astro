---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projects">
  <section class="mx-auto max-w-screen-2xl px-6 py-14 md:px-10 md:py-20">
    <header class="mb-12 flex items-baseline justify-end md:mb-16">
      <p class="eyebrow">{projects.length} works</p>
    </header>

    {/* Masonry: images keep their native aspect ratio and pack together */}
    <div class="columns-1 gap-x-6 sm:columns-2 sm:gap-x-8 lg:columns-3 lg:gap-x-10">
      {
        projects.map((project, i) => (
          <div class="mb-6 break-inside-avoid sm:mb-8 lg:mb-10">
            <ProjectCard project={project} native eager={i < 3} />
          </div>
        ))
      }
    </div>
  </section>
</Base>
