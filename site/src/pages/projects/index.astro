---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projects">
  <section class="mx-auto max-w-screen-3xl px-6 py-14 lg:px-40 xl:px-80 md:py-20">
    <header class="mb-12 flex items-baseline justify-end md:mb-16">
      <p class="eyebrow">{projects.length} works</p>
    </header>

    {/*
      Masonry packed in ROW order: the cards below are dealt left-to-right
      across the columns (1,2,3 / 4,5,6 ...) by the script underneath, so
      reading order runs across rather than down. CSS multi-column cannot do
      this — it always fills a column before starting the next — and
      `grid-template-rows: masonry` is not shipped anywhere yet.

      Without JavaScript this stays a plain aligned grid in the correct order:
      images keep their native ratio, cards just don't pack tightly.
    */}
    <div
      data-project-grid
      class="grid grid-cols-1 items-start gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3 lg:gap-10 xl:gap-15"
    >
      {
        projects.map((project, i) => (
          <div>
            <ProjectCard project={project} native eager={i < 3} />
          </div>
        ))
      }
    </div>

    <script is:inline>
      (() => {
        const grid = document.querySelector("[data-project-grid]");
        if (!grid) return;

        // Snapshot the cards once; relayouts move these same nodes, so
        // already-decoded images are never re-fetched.
        const cards = Array.from(grid.children);
        let columns = 0;

        // Read the column count from the CSS grid itself rather than
        // hard-coding breakpoints, so Tailwind stays the source of truth.
        const columnCount = () => {
          const tracks = getComputedStyle(grid).gridTemplateColumns;
          return tracks && tracks !== "none" ? tracks.split(" ").length : 1;
        };

        const layout = () => {
          const n = columnCount();
          if (n === columns) return;
          columns = n;

          grid.replaceChildren();
          const cols = Array.from({ length: n }, () => {
            const col = document.createElement("div");
            col.className = "flex min-w-0 flex-col gap-6 sm:gap-8 lg:gap-10";
            grid.appendChild(col);
            return col;
          });
          cards.forEach((card, i) => cols[i % n].appendChild(card));
        };

        layout();

        let pending;
        window.addEventListener("resize", () => {
          clearTimeout(pending);
          pending = setTimeout(layout, 150);
        });
      })();
    </script>
  </section>
</Base>
