---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
---

<Base title="Contact">
  <section class="mx-auto max-w-screen-2xl px-6 py-14 md:px-10 md:py-20">
    <div class="grid gap-16 md:grid-cols-[1fr_280px]">
      <div>
        <p class="eyebrow">Commissions · Collaborations · Teaching · Press</p>
        <a
          href="mailto:info@agoradev.co.site"
          class="mt-6 block max-w-full text-2xl font-light tracking-tight break-all transition-colors hover:text-brand md:text-4xl"
        >
          info@agoradev.co.site
        </a>

        <dl class="mt-14 grid max-w-md gap-8 sm:grid-cols-2">
          <div>
            <dt class="eyebrow">Telephone</dt>
            <dd class="mt-2 text-sm text-ink/80">
              <a href="tel:+19177721242" class="transition-colors hover:text-brand"
                >+1 917 772 1242</a
              >
            </dd>
          </div>
          <div>
            <dt class="eyebrow">Curriculum vitae</dt>
            <dd class="mt-2 text-sm text-ink/80">
              <a
                href="/Minquan_Wang_CV.pdf"
                class="underline underline-offset-3 transition-colors hover:text-brand"
                >Download PDF</a
              >
            </dd>
          </div>
        </dl>
      </div>

      <div class="hidden md:flex md:items-start md:justify-end">
        <Logo class="h-40 w-auto" />
      </div>
    </div>
  </section>
</Base>
