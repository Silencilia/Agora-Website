---
import Base from "../layouts/Base.astro";
import FeaturedShowcase from "../components/FeaturedShowcase.astro";
import Logo from "../components/Logo.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
---

<Base fullBleed>
  <FeaturedShowcase />

  {/* Reserves the height of the fixed showcase so it shows through first */}
  <div class="h-[100svh]" aria-hidden="true"></div>

  {/* Content scrolls up over the fixed showcase */}
  <div class="relative z-10 bg-paper">
    <section
      class="mx-auto flex max-w-3xl flex-col items-center px-6 py-24 text-center md:py-36"
    >
      <Logo class="mb-10 h-14 w-auto md:h-32" />
      <p
        class="text-2xl leading-snug font-light tracking-tight text-balance md:text-4xl"
      >
        AGORA is a full-service architecture and interior design studio based in New York. Founded by Minquan Wang in 2024, it builds the public realm at the intersection of technology and culture.
      </p>
      <a
        href="/about/"
        class="group mt-10 inline-flex items-center gap-3 text-[0.7rem] uppercase tracking-(--tracking-eyebrow) text-ink/70 transition-colors hover:text-brand"
      >
        About the practice
        <ArrowIcon
          class="h-3 w-3 rotate-180 transition-transform group-hover:translate-x-1"
        />
      </a>
    </section>
  </div>
</Base>
